# Copiar este archivo a .env antes de arrancar. Valores ficticios solo para el laboratorio.

# PostgreSQL
PG_DB=mensajeria
PG_USER=mensajeria_user
PG_PASSWORD=cambiar_esto
POSTGRES_HOST=postgres

# MongoDB
MONGO_USER=mongo_user
MONGO_PASSWORD=cambiar_esto
MONGO_DB=mensajeria
MONGO_HOST=mongo

# Redis
REDIS_PASSWORD=cambiar_esto
REDIS_HOST=redis

# Orígenes desde los que la web puede llamar a la API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Cada cuántos segundos revisa el worker el outbox
SYNC_INTERVALO_SEGUNDOS=2
